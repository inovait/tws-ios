","type":"text"}],"kind":"article","title":"Getting Started","type":"topic"},"doc://tws-ios.TWS/documentation/TWS/TWSIntercepted/url(_:navigationType:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"url","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"navigationType","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:3TWS17TWSNavigationTypeO","text":"TWSNavigationType","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/tws\/twsintercepted\/url(_:navigationtype:)","abstract":[{"type":"text","text":"A content load the web view is about to perform, and what caused it."}],"kind":"symbol","title":"TWSIntercepted.url(_:navigationType:)","identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSIntercepted\/url(_:navigationType:)","type":"topic","role":"symbol"},"doc://tws-ios.TWS/documentation/TWS/TWSViewNavigator/pushState(path:)":{"identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSViewNavigator\/pushState(path:)","role":"symbol","abstract":[{"type":"text","text":"Triggers the delegate to inject pushState JavaScript into webView."},{"type":"text","text":" "},{"type":"text","text":"Used for navigating SPA web page, by pushing a new history entry to the history stack."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pushState","kind":"identifier"},{"text":"(","kind":"text"},{"text":"path","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"pushState(path:)","kind":"symbol","type":"topic","url":"\/documentation\/tws\/twsviewnavigator\/pushstate(path:)"},"doc://tws-ios.TWS/documentation/TWS/TWSViewNavigator":{"abstract":[{"type":"text","text":"A class that handles navigation actions such as navigating to a certain URL programmatically, going back, going forward, or reloading within a "},{"identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSView","type":"reference","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/tws\/twsviewnavigator","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"TWSViewNavigator","kind":"identifier"}],"kind":"symbol","title":"TWSViewNavigator","navigatorTitle":[{"text":"TWSViewNavigator","kind":"identifier"}],"identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSViewNavigator","type":"topic"},"doc://tws-ios.TWS/documentation/TWS/TWSViewNavigator/replaceState(path:)":{"abstract":[{"type":"text","text":"Triggers the delegate to inject replaceState JavaScript into webView."},{"type":"text","text":" "},{"type":"text","text":"Used for navigating SPA web page, by modifying the current history entry of the history stack."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSViewNavigator\/replaceState(path:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceState","kind":"identifier"},{"text":"(","kind":"text"},{"text":"path","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/tws\/twsviewnavigator\/replacestate(path:)","title":"replaceState(path:)"},"doc://tws-ios.TWS/documentation/TWS/01_Customizations":{"abstract":[{"text":"Discover how to customize TWS to align with your app’s design and functionality by tailoring services and views for a seamless user experience.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/01_Customizations","role":"article","url":"\/documentation\/tws\/01_customizations","title":"Stylings and customizations"},"doc://tws-ios.TWS/documentation/TWS/02_FileDownloads":{"identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/02_FileDownloads","role":"article","url":"\/documentation\/tws\/02_filedownloads","abstract":[{"text":"Manage File Downloads and Access","type":"text"}],"kind":"article","title":"File Downloads","type":"topic"},"doc://tws-ios.TWS/documentation/TWS/TWSIntercepted/path(_:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"path","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/tws\/twsintercepted\/path(_:)","abstract":[{"type":"text","text":"An SPA navigation reported by the JavaScript bridge."}],"kind":"symbol","title":"TWSIntercepted.path(_:)","identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSIntercepted\/path(_:)","type":"topic","role":"symbol"}}}