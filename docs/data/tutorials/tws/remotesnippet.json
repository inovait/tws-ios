{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/tws\/remotesnippet"]}],"metadata":{"categoryPathComponent":"Tutorial-Table-of-Contents","title":"Display your first remote snippet","role":"project","category":"Learn to use the SDK"},"sections":[{"kind":"hero","estimatedTimeInMinutes":3,"content":[{"type":"paragraph","inlineContent":[{"text":"Learn how to set up a manager to handle the logic and functionality of your snippets, as well as how to seamlessly integrate them into your SwiftUI views.","type":"text"}]}],"title":"Display your first remote snippet","chapter":"Display your first snippet"},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The fundamental building block for managing and interacting with snippets in TWS is creating and configuring a project on the ","type":"text"},{"identifier":"https:\/\/thewebsnippet.com","isActive":true,"type":"reference"},{"text":". A project serves as the core unit for organizing and managing snippets, allowing you to structure and customize functionality for your application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This includes retrieving your organization and project IDs, adding snippets to the project, modifying their properties, and integrating them seamlessly into your app. By managing these elements through the TWS portal, you can ensure consistency and scalability across your application’s features.","type":"text"}]},{"inlineContent":[{"text":"Most importantly, managing your snippets through the portal keeps the core logic and configuration independent from the app’s UI, making it easier to test, maintain, and reuse across different environments.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"Connect-with-the-TWS-portal","title":"Connect with the TWS portal","stepsSection":[{"runtimePreview":null,"caption":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Make sure to keep a reference to the project ID, as you will need it later in the setup and integration process.","type":"text"}]}],"type":"aside","style":"note","name":"Note"}],"content":[{"inlineContent":[{"text":"Create a project on the TWS portal. Once completed, the next step is to integrate it into your app.","type":"text"}],"type":"paragraph"}],"media":null,"code":"RemoteSnippet_00.swift","type":"step"},{"runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"text":"Import the TWS module at the app’s entry point.","type":"text"}],"type":"paragraph"}],"media":null,"code":"RemoteSnippet_01.swift","type":"step"},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Use one of the available methods to inject the manager into your view.","type":"text"}]}],"caption":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Under the hood, an instance of ","type":"text"},{"type":"codeVoice","code":"TWSManager"},{"text":" is created and registered with the remote services, establishing a socket connection to the server and handling updates via an ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" manager. If called multiple times, the same instance is shared instead of being recreated."}]}],"name":"Note","type":"aside","style":"note"}],"runtimePreview":null,"type":"step","code":"RemoteSnippet_02.swift"}]},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"After injecting it into the view, you can access the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSManager"},{"text":" from anywhere in the view by retrieving it from the environment. Use the observable object to display snippets and listen for updates seamlessly.","type":"text"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"Presenting-snippets","title":"Presenting snippets","stepsSection":[{"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Navigate to the view where you want to display the snippets.","type":"text"}],"type":"paragraph"}],"type":"step","code":"RemoteSnippet_03.swift","caption":[]},{"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Pull the ","type":"text"},{"identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSManager","isActive":true,"type":"reference"},{"text":" from the environment.","type":"text"}],"type":"paragraph"}],"type":"step","code":"RemoteSnippet_04.swift","caption":[]},{"media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Loop over all the snippets.","type":"text"}]}],"type":"step","code":"RemoteSnippet_05.swift","caption":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You will be notified about the changes when snippets are added, removed or updated."}]}],"name":"Note","type":"aside","style":"note"}]},{"media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Utilize the ","type":"text"},{"identifier":"doc:\/\/tws-ios.TWS\/documentation\/TWS\/TWSView","isActive":true,"type":"reference"},{"text":" to display the snippets within the view hierarchy.","type":"text"}]}],"type":"step","code":"RemoteSnippet_06.swift","caption":[{"type":"paragraph","inlineContent":[{"text":"Check the next tutorial to see all the ways to manager your TWSManager instance.","type":"text"}]}]}]}]},{"kind":"callToAction","title":"Creating and managing TWSManager","featuredEyebrow":"Tutorial","action":{"isActive":true,"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/tws-ios.TWS\/tutorials\/TWS\/ManagerCreation","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"abstract":[{"text":"Learn different ways of creating and managing TWSManager","type":"text"}]}],"kind":"project","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"reference":"doc:\/\/tws-ios.TWS\/tutorials\/Tutorial-Table-of-Contents","paths":[[